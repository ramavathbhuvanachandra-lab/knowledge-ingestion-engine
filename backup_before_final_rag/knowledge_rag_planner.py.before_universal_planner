    # ==================================================================
    # PUBLIC API
    # ==================================================================

    def plan_domain(
        self,
        domain: str,
    ) -> dict:

        domain = (
            domain or ""
        ).strip()

        if not domain:
            raise ValueError(
                "Domain cannot be empty."
            )

        domain_root = (
            self.organized_root
            / domain
        )

        manifest_path = (
            domain_root
            / "knowledge_units.json"
        )

        if not manifest_path.exists():
            raise FileNotFoundError(
                "Knowledge-unit manifest does not exist: "
                f"{manifest_path}"
            )

        data = json.loads(
            manifest_path.read_text(
                encoding="utf-8"
            )
        )

        units = data.get(
            "units",
            []
        )

        if not isinstance(
            units,
            list,
        ):
            raise ValueError(
                "'units' must be a list."
            )

        # --------------------------------------------------------------
        # VALIDATE INPUT
        # --------------------------------------------------------------

        useful_units = []

        for unit in units:

            if not isinstance(
                unit,
                dict,
            ):
                continue

            decision = (
                unit.get(
                    "decision",
                    "KEEP",
                )
            )

            # Only explicit NOISE is excluded.
            if decision == "NOISE":
                continue

            required = (
                "unit_id",
                "source_document",
                "heading",
                "text",
                "topic",
                "subtopic",
            )

            missing = [
                field
                for field in required
                if not unit.get(field)
            ]

            if missing:
                raise ValueError(
                    "Knowledge unit is missing "
                    f"{missing}: {unit}"
                )

            useful_units.append(
                unit
            )

        if not useful_units:
            raise ValueError(
                f"No useful knowledge units found for "
                f"{domain}."
            )

        # --------------------------------------------------------------
        # INITIAL TAXONOMY BUCKETING
        # --------------------------------------------------------------

        buckets = defaultdict(list)

        for unit in useful_units:

            family = (
                self._resolve_family(
                    unit
                )
            )

            buckets[
                family
            ].append(
                unit
            )

        # --------------------------------------------------------------
        # SPLIT LARGE FAMILIES
        # --------------------------------------------------------------

        buckets = (
            self._split_large_families(
                buckets
            )
        )

        # --------------------------------------------------------------
        # MERGE TINY FAMILIES
        # --------------------------------------------------------------

        buckets = (
            self._merge_tiny_families(
                buckets
            )

        )

        # --------------------------------------------------------------
        # BUILD DOCUMENT PLANS
        # --------------------------------------------------------------

        documents = []

        for document_name in sorted(
            buckets.keys()
        ):

            document_units = buckets[
                document_name
            ]

            document_units.sort(
                key=self._unit_sort_key
            )

            topics = sorted(
                {
                    unit.get(
                        "topic",
                        "other",
                    )
                    for unit in document_units
                }
            )

            taxonomy_categories = sorted(
                {
                    "/".join(
                        [
                            unit.get(
                                "taxonomy_domain",
                                unit.get(
                                    "topic",
                                    "other",
                                ),
                            ),
                            unit.get(
                                "taxonomy_category",
                                unit.get(
                                    "subtopic",
                                    "other",
                                ),
                            ),
                        ]
                    )
                    for unit in document_units
                }
            )

            source_documents = sorted(
                {
                    unit[
                        "source_document"
                    ]
                    for unit in document_units
                }
            )

            title = (
                self.DISPLAY_NAMES.get(
                    document_name,
                    self._display_name(
                        document_name
                    ),
                )
            )

            documents.append(
                {
                    "document_id": (
                        document_name
                    ),

                    "filename": (
                        f"{document_name}.docx"
                    ),

                    "title": title,

                    "topics": topics,

                    "taxonomy_categories": (
                        taxonomy_categories
                    ),

                    "source_documents": (
                        source_documents
                    ),

                    "unit_count": len(
                        document_units
                    ),

                    "units": (
                        document_units
                    ),
                }
            )

        # --------------------------------------------------------------
        # COVERAGE VALIDATION
        # --------------------------------------------------------------

        planned_unit_ids = []

        for document in documents:

            for unit in document[
                "units"
            ]:

                planned_unit_ids.append(
                    unit["unit_id"]
                )

        input_unit_ids = [
            unit["unit_id"]
            for unit in useful_units
        ]

        duplicate_input_ids = (
            self._duplicates(
                input_unit_ids
            )
        )

        duplicate_planned_ids = (
            self._duplicates(
                planned_unit_ids
            )
        )

        if duplicate_input_ids:
            raise ValueError(
                "Duplicate input knowledge-unit IDs: "
                f"{duplicate_input_ids}"
            )

        if duplicate_planned_ids:
            raise ValueError(
                "Duplicate planned knowledge-unit IDs: "
                f"{duplicate_planned_ids}"
            )

        missing_ids = sorted(
            set(input_unit_ids)
            - set(planned_unit_ids)
        )

        extra_ids = sorted(
            set(planned_unit_ids)
            - set(input_unit_ids)
        )

        if missing_ids:
            raise ValueError(
                "Knowledge units were lost during RAG planning: "
                f"{missing_ids}"
            )

        if extra_ids:
            raise ValueError(
                "RAG plan contains unknown knowledge units: "
                f"{extra_ids}"
            )

        if len(input_unit_ids) != len(
            planned_unit_ids
        ):
            raise ValueError(
                "RAG plan coverage mismatch."
            )

        # --------------------------------------------------------------
        # FINAL STATISTICS
        # --------------------------------------------------------------

        topic_counts = defaultdict(int)

        taxonomy_counts = defaultdict(int)

        for unit in useful_units:

            topic_counts[
                unit.get(
                    "topic",
                    "other",
                )
            ] += 1

            taxonomy_key = "/".join(
                [
                    unit.get(
                        "taxonomy_domain",
                        unit.get(
                            "topic",
                            "other",
                        ),
                    ),
                    unit.get(
                        "taxonomy_category",
                        unit.get(
                            "subtopic",
                            "other",
                        ),
                    ),
                ]
            )

            taxonomy_counts[
                taxonomy_key
            ] += 1

        # --------------------------------------------------------------
        # DOCUMENT DISTRIBUTION
        # --------------------------------------------------------------

        document_counts = {
            document["document_id"]: (
                document["unit_count"]
            )
            for document in documents
        }

        # --------------------------------------------------------------
        # FINAL PLAN
        # --------------------------------------------------------------

        plan = {
            "version": "2.0",

            "planner": (
                "KnowledgeRAGPlanner"
            ),

            "strategy": (
                "deterministic_dynamic_taxonomy_grouping"
            ),

            "domain": domain,

            "input_manifest": str(
                manifest_path
            ),

            "source_documents": sorted(
                {
                    unit[
                        "source_document"
                    ]
                    for unit in useful_units
                }
            ),

            "input_units": len(
                useful_units
            ),

            "rag_documents": len(
                documents
            ),

            "target_document_range": {
                "soft_min": 20,
                "soft_max": 30,
            },

            "topic_counts": dict(
                sorted(
                    topic_counts.items()
                )
            ),

            "taxonomy_counts": dict(
                sorted(
                    taxonomy_counts.items()
                )
            ),

            "document_counts": (
                document_counts
            ),

            "coverage": {
                "input_units": len(
                    useful_units
                ),

                "planned_units": len(
                    planned_unit_ids
                ),

                "missing_units": 0,

                "extra_units": 0,

                "coverage_complete": True,
            },

            "documents": documents,
        }

        # --------------------------------------------------------------
        # WRITE PLAN
        # --------------------------------------------------------------

        output_path = (
            domain_root
            / "rag_plan.json"
        )

        output_path.write_text(
            json.dumps(
                plan,
                indent=4,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

        # --------------------------------------------------------------
        # LOGGING
        # --------------------------------------------------------------

        print()
        print("=" * 100)
        print(
            "PHASE 8.4 — DYNAMIC RAG PLANNER V2"
        )
        print("=" * 100)

        print(
            "Domain:",
            domain,
        )

        print(
            "Input units:",
            plan["input_units"],
        )

        print(
            "RAG documents:",
            plan["rag_documents"],
        )

        print(
            "Target range:",
            "20-30 soft target",
        )

        print(
            "Coverage:",
            (
                "PASS"
                if plan[
                    "coverage"
                ][
                    "coverage_complete"
                ]
                else "FAIL"
            ),
        )

        print()
        print(
            "RAG DOCUMENT PLAN"
        )

        for document in documents:

            print(
                f"{document['filename']:50s}"
                f" → "
                f"{document['unit_count']} units"
            )

        print()
        print(
            "Plan:",
            output_path,
        )

        return plan

    # ==================================================================
    # RESOLVE FAMILY
    # ==================================================================

    def _resolve_family(
        self,
        unit: dict,
    ) -> str:

        taxonomy_domain = (
            self._normalize_topic(
                unit.get(
                    "taxonomy_domain",
                    unit.get(
                        "topic",
                        "other",
                    ),
                )
            )
        )

        taxonomy_category = (
            self._normalize_topic(
                unit.get(
                    "taxonomy_category",
                    unit.get(
                        "subtopic",
                        "other",
                    ),
                )
            )
        )

        key = (
            taxonomy_domain,
            taxonomy_category,
        )

        # Explicit family mapping.
        for family_name, definition in (
            self.FAMILY_RULES.items()
        ):

            if key in definition[
                "categories"
            ]:
                return family_name

        # Any review material initially goes to
        # the safety-net family.
        if taxonomy_domain == "review":
            return (
                "special_content_and_miscellaneous"
            )

        # --------------------------------------------------------------
        # DOMAIN FALLBACK
        # --------------------------------------------------------------

        return self._domain_fallback(
            taxonomy_domain
        )

    # ==================================================================
    # DOMAIN FALLBACK
    # ==================================================================

    def _domain_fallback(
        self,
        domain: str,
    ) -> str:

        fallback = {

            "campus":
                "campus_and_infrastructure",

            "academics":
                "academic_programs",

            "research":
                "research_outputs_and_innovation",

            "people":
                "people_and_leadership",

            "admissions":
                "academic_programs",

            "student_life":
                "student_life_and_welfare",

            "hostels":
                "student_residential_life",

            "food_and_dining":
                "student_residential_life",

            "finance_and_fees":
                "fees_scholarships_and_finance",

            "careers_and_placements":
                "careers_and_placements",

            "administration":
                "administration_and_governance",

            "rules_policies_and_regulations":
                "administration_and_governance",

            "facilities_and_infrastructure":
                "campus_and_infrastructure",

            "health_safety_and_wellbeing":
                "health_safety_and_wellbeing",

            "events_and_activities":
                "events_notices_and_announcements",

            "notices_and_announcements":
                "events_notices_and_announcements",

            "contacts_and_directory":
                "contacts_and_directory",

            "institutes_centres_and_units":
                "institute_overview",
        }

        return fallback.get(
            domain,
            "special_content_and_miscellaneous",
        )

    # ==================================================================
    # SPLIT LARGE FAMILIES
    # ==================================================================

    def _split_large_families(
        self,
        buckets: dict[str, list[dict]],
    ) -> dict[str, list[dict]]:

        final = defaultdict(list)

        for family_name, units in buckets.items():

            rule = self.SPLIT_FAMILIES.get(
                family_name
            )

            if not rule:
                final[
                    family_name
                ].extend(
                    units
                )
                continue

            max_units = int(
                rule["max_units"]
            )

            if len(units) <= max_units:
                final[
                    family_name
                ].extend(
                    units
                )
                continue

            # ----------------------------------------------------------
            # Split using taxonomy category.
            #
            # This is preferable to blindly slicing by 180 because it
            # keeps coherent knowledge categories together.
            # ----------------------------------------------------------

            category_groups = defaultdict(
                list
            )

            for unit in units:

                key = (
                    self._normalize_topic(
                        unit.get(
                            "taxonomy_domain",
                            unit.get(
                                "topic",
                                "other",
                            ),
                        )
                    ),
                    self._normalize_topic(
                        unit.get(
                            "taxonomy_category",
                            unit.get(
                                "subtopic",
                                "other",
                            ),
                        )
                    ),
                )

                category_groups[
                    key
                ].append(
                    unit
                )

            # ----------------------------------------------------------
            # If category buckets themselves are too large, partition
            # them deterministically.
            # ----------------------------------------------------------

            current_index = 1

            current_name = family_name

            current_count = 0

            for category_key in sorted(
                category_groups.keys()
            ):

                category_units = (
                    category_groups[
                        category_key
                    ]
                )

                category_units.sort(
                    key=self._unit_sort_key
                )

                if (
                    current_count
                    + len(category_units)
                    > max_units
                    and current_count > 0
                ):
                    current_index += 1
                    current_count = 0

                if current_index == 1:
                    target_name = current_name
                else:
                    target_name = (
                        f"{family_name}_"
                        f"{current_index:02d}"
                    )

                final[
                    target_name
                ].extend(
                    category_units
                )

                current_count += len(
                    category_units
                )

                # ------------------------------------------------------
                # A single category may itself exceed the threshold.
                # Partition that category if necessary.
                # ------------------------------------------------------

                if current_count > (
                    max_units * 2
                ):
                    # This is rare. Rebuild this family deterministically.
                    oversized = final[
                        target_name
                    ]

                    del final[
                        target_name
                    ]

                    chunks = self._chunk_units(
                        oversized,
                        max_units,
                    )

                    for index, chunk in enumerate(
                        chunks,
                        start=1,
                    ):

                        if index == 1:
                            name = target_name
                        else:
                            name = (
                                f"{family_name}_"
                                f"{current_index + index - 1:02d}"
                            )

                        final[
                            name
                        ].extend(
                            chunk
                        )

                    current_index += (
                        len(chunks) - 1
                    )

                    current_count = len(
                        chunks[-1]
                    )

        return {
            key: list(value)
            for key, value in final.items()
        }

    # ==================================================================
    # MERGE TINY FAMILIES
    # ==================================================================

    def _merge_tiny_families(
        self,
        buckets: dict[str, list[dict]],
    ) -> dict[str, list[dict]]:

        result = {
            key: list(value)
            for key, value in buckets.items()
        }

        # Small families are valid. We only merge clearly tiny families
        # when doing so produces a sensible semantic combination.
        #
        # This prevents dozens of 1-5 unit documents.
        tiny = {
            name: units
            for name, units in result.items()
            if len(units) <= 5
            and name
            not in {
                "special_content_and_miscellaneous",
            }
        }

        if not tiny:
            return result

        # Candidate merge families in priority order.
        merge_targets = [
            (
                {
                    "administration_and_governance",
                    "contacts_and_directory",
                },
                "administration_and_governance",
            ),
            (
                {
                    "library_and_learning_facilities",
                    "campus_and_infrastructure",
                },
                "campus_and_infrastructure",
            ),
            (
                {
                    "fees_scholarships_and_finance",
                    "careers_and_placements",
                },
                "careers_and_placements",
            ),
            (
                {
                    "events_notices_and_announcements",
                    "special_programs_and_initiatives",
                },
                "events_notices_and_announcements",
            ),
        ]

        for family_set, target in merge_targets:

            present = [
                name
                for name in family_set
                if name in result
            ]

            if len(present) < 2:
                continue

            if all(
                name in tiny
                for name in present
            ):

                combined = []

                for name in present:
                    combined.extend(
                        result.pop(name)
                    )

                result.setdefault(
                    target,
                    []
                ).extend(
                    combined
                )

        return result

    # ==================================================================
    # CHUNK OVERSIZED CATEGORY
    # ==================================================================

    def _chunk_units(
        self,
        units: list[dict],
        max_units: int,
    ) -> list[list[dict]]:

        units = sorted(
            units,
            key=self._unit_sort_key
        )

        chunks = []

        for start in range(
            0,
            len(units),
            max_units,
        ):
            chunks.append(
                units[
                    start:
                    start + max_units
                ]
            )

        return chunks

    # ==================================================================
    # UNIT SORT
    # ==================================================================

    def _unit_sort_key(
        self,
        unit: dict,
    ) -> tuple:

        try:
            section_index = int(
                unit.get(
                    "section_index",
                    0,
                )
            )
        except (
            TypeError,
            ValueError,
        ):
            section_index = 0

        try:
            page_index = int(
                unit.get(
                    "page_index",
                    0,
                )
            )
        except (
            TypeError,
            ValueError,
        ):
            page_index = 0

        return (
            unit.get(
                "source_document",
                "",
            ),
            page_index,
            section_index,
        )

    # ==================================================================
    # TOPIC NORMALIZATION
    # ==================================================================

    def _normalize_topic(
        self,
        topic: str,
    ) -> str:

        topic = (
            topic
            or "other"
        ).strip().lower()

        topic = re.sub(
            r"[^a-z0-9_]+",
            "_",
            topic,
        )

        topic = re.sub(
            r"_+",
            "_",
            topic,
        )

        return (
            topic.strip("_")
            or "other"
        )

    # ==================================================================
    # DISPLAY NAME
    # ==================================================================

    def _display_name(
        self,
        value: str,
    ) -> str:

        value = re.sub(
            r"[_\-]+",
            " ",
            value,
        )

        value = re.sub(
            r"\s+",
            " ",
            value,
        )

        return (
            value
            .strip()
            .title()
        )

    # ==================================================================
    # DUPLICATE DETECTION
    # ==================================================================

    def _duplicates(
        self,
        values: list[str],
    ) -> list[str]:

        seen = set()
        duplicates = set()

        for value in values:

            if value in seen:
                duplicates.add(
                    value
                )

            seen.add(
                value
            )

        return sorted(
            duplicates
        )



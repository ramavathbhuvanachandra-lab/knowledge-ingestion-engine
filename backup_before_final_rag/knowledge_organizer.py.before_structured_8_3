"""
Phase 8.3 — Deterministic Knowledge Organization.

Input:
    Canonical / cleaned Markdown knowledge

Output:
    storage/organized_knowledge/<domain>/
        <taxonomy_domain>/
            <taxonomy_category>/
                <taxonomy_subcategory>.md

Responsibilities:
- Parse knowledge sections.
- Preserve useful knowledge.
- Preserve KEEP and REVIEW.
- Exclude only explicit NOISE.
- Apply the deterministic master taxonomy.
- Preserve original section text.
- Preserve source line provenance.
- Produce an organization manifest.

This phase does NOT:
- use an LLM
- chunk
- embed
- create vectors
- summarize
- rewrite knowledge
"""

from __future__ import annotations

from pathlib import Path
import hashlib
import json
import re

from processors.knowledge_taxonomy import classify


class KnowledgeOrganizer:

    def __init__(
        self,
        output_path: str | Path = "storage/organized_knowledge",
        organized_root: str | Path | None = None,
    ):
        self.output_path = Path(
            organized_root
            if organized_root is not None
            else output_path
        )

        self.noise_headings = {
            "search here",
            "accessibility options",
            "accessibility",
            "menu",
            "navigation",
            "quick access",
            "quick links",
            "important links",
            "useful links",
        }

        self.noise_exact_content = {
            "accessibility options",
            "created by",
            "arrow downward",
        }

    # ==================================================================
    # PUBLIC API
    # ==================================================================

    def organize(
        self,
        markdown_path: str | Path,
    ) -> dict:

        markdown_path = Path(
            markdown_path
        )

        if not markdown_path.exists():
            raise FileNotFoundError(
                f"Knowledge Markdown does not exist: "
                f"{markdown_path}"
            )

        content = markdown_path.read_text(
            encoding="utf-8"
        )

        domain = self._extract_domain(
            markdown_path,
            content,
        )

        sections = self._parse_sections(
            content
        )

        units: list[dict] = []

        noise_count = 0

        for index, section in enumerate(
            sections
        ):

            if section["decision"] == "NOISE":
                noise_count += 1
                continue

            classification = classify(
                heading=section["heading"],
                text=section["text"],
                source_name=markdown_path.name,
            )

            unit = {
                "unit_id": self._make_unit_id(
                    markdown_path,
                    index,
                ),

                "source_document": str(
                    markdown_path
                ),

                "source_document_name": (
                    markdown_path.name
                ),

                "domain": domain,

                "heading": section["heading"],

                "level": section["level"],

                "text": section["text"],

                "start_line": section["start_line"],

                "end_line": section["end_line"],

                "decision": section["decision"],

                # ------------------------------------------------------
                # MASTER TAXONOMY
                # ------------------------------------------------------

                "taxonomy_domain": (
                    classification["domain"]
                ),

                "taxonomy_category": (
                    classification["category"]
                ),

                "taxonomy_subcategory": (
                    classification["subcategory"]
                ),

                "classification_confidence": (
                    classification["confidence"]
                ),

                "classification_score": (
                    classification["score"]
                ),
            }

            units.append(unit)

        # --------------------------------------------------------------
        # WRITE ORGANIZED MARKDOWN
        # --------------------------------------------------------------

        grouped: dict[
            tuple[str, str, str],
            list[dict],
        ] = {}

        for unit in units:

            key = (
                unit["taxonomy_domain"],
                unit["taxonomy_category"],
                unit["taxonomy_subcategory"],
            )

            grouped.setdefault(
                key,
                [],
            ).append(unit)

        domain_root = (
            self.output_path / domain
        )

        domain_root.mkdir(
            parents=True,
            exist_ok=True,
        )

        written_files = []

        for key in sorted(grouped):

            (
                taxonomy_domain,
                taxonomy_category,
                taxonomy_subcategory,
            ) = key

            output_dir = (
                domain_root
                / self._safe_name(
                    taxonomy_domain
                )
                / self._safe_name(
                    taxonomy_category
                )
            )

            output_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            output_file = (
                output_dir
                / f"{self._safe_name(taxonomy_subcategory)}.md"
            )

            self._write_group_file(
                output_file=output_file,
                domain=domain,
                taxonomy_domain=taxonomy_domain,
                taxonomy_category=taxonomy_category,
                taxonomy_subcategory=taxonomy_subcategory,
                source_document=markdown_path,
                units=grouped[key],
            )

            written_files.append(
                str(output_file)
            )

        # --------------------------------------------------------------
        # CATEGORY COUNTS
        # --------------------------------------------------------------

        category_counts: dict[str, int] = {}

        for unit in units:

            key = "/".join(
                (
                    unit["taxonomy_domain"],
                    unit["taxonomy_category"],
                    unit["taxonomy_subcategory"],
                )
            )

            category_counts[key] = (
                category_counts.get(
                    key,
                    0,
                )
                + 1
            )

        review_count = sum(
            1
            for unit in units
            if unit["taxonomy_domain"]
            == "review"
        )

        # --------------------------------------------------------------
        # MANIFEST
        # --------------------------------------------------------------

        manifest = {
            "phase": "8.3",

            "source_document": str(
                markdown_path
            ),

            "source_document_name": (
                markdown_path.name
            ),

            "domain": domain,

            "total_sections": len(
                sections
            ),

            "noise_sections": noise_count,

            "organized_sections": len(
                units
            ),

            "review_sections": review_count,

            "category_counts": (
                category_counts
            ),

            "written_files": (
                written_files
            ),

            "units": units,
        }

        manifest_path = (
            domain_root
            / (
                f"{markdown_path.stem}"
                ".organization.json"
            )
        )

        manifest_path.write_text(
            json.dumps(
                manifest,
                indent=2,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

        return manifest

    # ==================================================================
    # MARKDOWN SECTION PARSER
    # ==================================================================

    def _parse_sections(
        self,
        content: str,
    ) -> list[dict]:

        lines = content.splitlines()

        sections: list[dict] = []

        current: dict | None = None

        pending_decision: str | None = None

        for line_number, line in enumerate(
            lines,
            start=1,
        ):

            decision = self._parse_decision(
                line
            )

            if decision:

                pending_decision = decision

                if current is not None:
                    current["end_line"] = (
                        line_number - 1
                    )

                continue

            heading_match = re.match(
                r"^(#{1,6})\s+(.+?)\s*$",
                line,
            )

            if heading_match:

                if current is not None:
                    current["end_line"] = (
                        line_number - 1
                    )

                    self._finalize_section(
                        sections,
                        current,
                    )

                current = {
                    "heading": (
                        heading_match
                        .group(2)
                        .strip()
                    ),

                    "level": len(
                        heading_match.group(1)
                    ),

                    "lines": [],

                    "start_line": line_number,

                    "end_line": line_number,

                    "decision": (
                        pending_decision
                        or "KEEP"
                    ),
                }

                pending_decision = None

                continue

            if current is None:

                if not line.strip():
                    continue

                current = {
                    "heading": "Document Overview",

                    "level": 1,

                    "lines": [],

                    "start_line": line_number,

                    "end_line": line_number,

                    "decision": (
                        pending_decision
                        or "KEEP"
                    ),
                }

                pending_decision = None

            current["lines"].append(line)

            current["end_line"] = (
                line_number
            )

        if current is not None:

            self._finalize_section(
                sections,
                current,
            )

        return sections

    # ==================================================================
    # SECTION FINALIZATION
    # ==================================================================

    def _finalize_section(
        self,
        sections: list[dict],
        section: dict,
    ):

        text = "\n".join(
            section["lines"]
        ).strip()

        heading = section[
            "heading"
        ]

        if not text:
            return

        decision = section[
            "decision"
        ]

        if self._is_noise_heading(
            heading
        ):
            decision = "NOISE"

        elif self._is_noise_content(
            text
        ):
            decision = "NOISE"

        sections.append(
            {
                "heading": heading,

                "level": section[
                    "level"
                ],

                "text": text,

                "start_line": section[
                    "start_line"
                ],

                "end_line": section[
                    "end_line"
                ],

                "decision": decision,
            }
        )

    # ==================================================================
    # DECISION PARSING
    # ==================================================================

    def _parse_decision(
        self,
        line: str,
    ) -> str | None:

        value = (
            line.strip()
            .upper()
        )

        if value in {
            "[KEEP]",
            "KEEP",
            "<KEEP>",
        }:
            return "KEEP"

        if value in {
            "[REVIEW]",
            "REVIEW",
            "<REVIEW>",
        }:
            return "REVIEW"

        if value in {
            "[NOISE]",
            "NOISE",
            "<NOISE>",
        }:
            return "NOISE"

        return None

    # ==================================================================
    # NOISE
    # ==================================================================

    def _is_noise_heading(
        self,
        heading: str,
    ) -> bool:

        normalized = self._normalize(
            heading
        )

        return (
            normalized
            in self.noise_headings
        )

    def _is_noise_content(
        self,
        text: str,
    ) -> bool:

        normalized = self._normalize(
            text
        )

        return (
            normalized
            in self.noise_exact_content
        )

    # ==================================================================
    # DOMAIN
    # ==================================================================

    def _extract_domain(
        self,
        markdown_path: Path,
        content: str,
    ) -> str:

        match = re.search(
            r"\*\*Domain:\*\*\s*(.+)",
            content,
            flags=re.IGNORECASE,
        )

        if match:

            value = self._safe_name(
                match.group(1)
            )

            if value:
                return value

        parts = markdown_path.parts

        for marker in (
            "knowledge",
            "structured_knowledge",
            "output",
        ):

            try:

                index = parts.index(
                    marker
                )

                if (
                    index + 1
                    < len(parts)
                ):

                    candidate = (
                        self._safe_name(
                            parts[index + 1]
                        )
                    )

                    if candidate:
                        return candidate

            except ValueError:
                continue

        return "unknown"

    # ==================================================================
    # WRITE ORGANIZED MARKDOWN
    # ==================================================================

    def _write_group_file(
        self,
        *,
        output_file: Path,
        domain: str,
        taxonomy_domain: str,
        taxonomy_category: str,
        taxonomy_subcategory: str,
        source_document: Path,
        units: list[dict],
    ):

        lines = [

            "# " + self._display(taxonomy_subcategory),

            "",

            f"**Domain:** {domain}",

            "**Taxonomy Domain:** " + taxonomy_domain,

            "**Taxonomy Category:** " + taxonomy_category,

            "**Taxonomy Subcategory:** " + taxonomy_subcategory,

            "**Source Document:** " + source_document.name,

            "",

            "---",

            "",
        ]

        for unit in units:

            lines.extend(
                [

                    f"## {unit['heading']}",

                    "",

                    # ORIGINAL TEXT
                    unit["text"],

                    "",

                    "---",

                    "",

                    (
                        "<!-- "
                        f"Unit ID: "
                        f"{unit['unit_id']} | "
                        f"Source lines: "
                        f"{unit['start_line']}-"
                        f"{unit['end_line']} | "
                        f"Decision: "
                        f"{unit['decision']} | "
                        f"Classification: "
                        f"{unit['taxonomy_domain']}/"
                        f"{unit['taxonomy_category']}/"
                        f"{unit['taxonomy_subcategory']}"
                        " -->"
                    ),

                    "",
                ]
            )

        output_file.write_text(
            "\n".join(lines),
            encoding="utf-8",
        )

    # ==================================================================
    # HELPERS
    # ==================================================================

    def _make_unit_id(
        self,
        markdown_path: Path,
        index: int,
    ) -> str:

        raw = (
            f"{markdown_path.resolve()}"
            f"::{index}"
        )

        return hashlib.sha1(
            raw.encode("utf-8")
        ).hexdigest()[:16]

    def _normalize(
        self,
        value: str,
    ) -> str:

        value = (
            value or ""
        ).strip().lower()

        value = re.sub(
            r"[^a-z0-9]+",
            " ",
            value,
        )

        return re.sub(
            r"\s+",
            " ",
            value,
        ).strip()

    def _safe_name(
        self,
        value: str,
    ) -> str:

        value = (
            value or ""
        ).strip().lower()

        value = re.sub(
            r"[^a-z0-9._-]+",
            "_",
            value,
        )

        value = re.sub(
            r"_+",
            "_",
            value,
        )

        return (
            value.strip("._-")
            or "unknown"
        )

    def _display(
        self,
        value: str,
    ) -> str:

        return (
            value
            .replace("_", " ")
            .title()
        )


if __name__ == "__main__":

    print(
        "KnowledgeOrganizer is a pipeline processor."
    )

    print(
        "Use: KnowledgeOrganizer().organize(path)"
    )

"""
Phase 8.4 — Universal Dynamic RAG Document Planner

This planner is intentionally college-agnostic.

Input
-----
8.3 knowledge_units.json

Output
------
rag_plan.json

Core principles
---------------
1. Never hardcode a specific college.
2. Never require a fixed number of final documents.
3. Never discard useful knowledge because classification is uncertain.
4. Semantic coherence is more important than raw unit count.
5. Taxonomy domain/category are the primary grouping signals.
6. Preserve source-document provenance.
7. Preserve section hierarchy.
8. Small compatible groups may be merged.
9. Large coherent groups may remain large.
10. Extremely large groups may be split deterministically.
11. REVIEW content is preserved in protected buffer documents.
12. Every non-NOISE unit must appear exactly once.
13. No LLM.
14. No embeddings.
15. No chunking.
16. No vector database.
17. No DOCX generation.
"""

from __future__ import annotations

from collections import Counter, defaultdict
from pathlib import Path
import json
import re


class KnowledgeRAGPlanner:

    # ================================================================
    # UNIVERSAL SOFT LIMITS
    # ================================================================
    #
    # These are NOT document-count rules.
    #
    # They are sanity limits for extremely large homogeneous groups.
    #
    # A coherent category below this size stays together.
    #
    # A category above this size is considered for natural splitting.
    # ================================================================

    SOFT_LARGE_GROUP_THRESHOLD = 220

    HARD_GROUP_THRESHOLD = 400

    SMALL_GROUP_THRESHOLD = 8

